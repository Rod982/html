@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    background: #105c5f;
    color: #fff;
    overflow-x: hidden;
    min-height: 100vh;
}

.cloud-layer {
    position: fixed;
    top: 0;
    left: 0;
    width: 200%;
    height: 100vh;
    display: flex;
    align-items: center;
    pointer-events: none;
    animation: cloudMove 55s linear infinite;
    z-index: -1;
}

.cloud {
    position: relative;
    width: 260px;
    height: 90px;
}

.cloud span {
    position: absolute;
    background: #fff;
    border-radius: 50%;
    opacity: 1;
}

.cloud span:nth-child(1) {
    width: 90px;
    height: 90px;
    left: 0;
    top: 20px;
}

.cloud span:nth-child(2) {
    width: 110px;
    height: 110px;
    left: 60px;
    top: 0;
}

.cloud span:nth-child(3) {
    width: 80px;
    height: 80px;
    left: 140px;
    top: 25px;
}

.layer1 {
    top: 10%;
    animation-duration: 75s;
}

.layer2 {
    top: 35%;
    animation-duration: 50s;
}

.layer3 {
    top: 60%;
    animation-duration: 30s;
}

@keyframes cloudMove {
    0% {
        transform: translateX(0);
    }

    100% {
        transform: translateX(-50%);
    }
}


.glass {
    background: rgba(255, 255, 255, .07);
    border: 1px solid rgba(255, 255, 255, .12);
    backdrop-filter: blur(12px);
    border-radius: 20px;
    box-shadow: 0 0 25px rgba(255, 255, 255, .08);
    padding: 40px;
    margin: 40px auto;
    max-width: 1100px;
}


header {
    position: sticky;
    top: 0;
    z-index: 20;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 35px;
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 30px;
}

.nav-links a {
    text-decoration: none;
    color: #fff;
    font-weight: 300;
    transition: .3s;
}

.nav-links a:hover {
    color: #a6a6a6;
}

.menu-btn {
    display: none;
    background: none;
    border: none;
    color: #fff;
    font-size: 30px;
    cursor: pointer;
}

section {
    padding: 100px 10%;
    text-align: center;
}

section h2 {
    font-size: 2.4rem;
    margin-bottom: 25px;
}

.cards-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 25px;
}

.card {
    text-align: center;
    padding: 25px;
}

.btn {
    background: #fff;
    color: #000;
    padding: 14px 26px;
    border: none;
    border-radius: 40px;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    transition: .3s;
    box-shadow: 0 0 12px rgba(255, 255, 255, .5);
}

.btn:hover {
    transform: scale(1.08);
    box-shadow: 0 0 20px #fff;
}


.contato {
    max-width: 650px;
}

.contato-form {
    display: flex;
    flex-direction: column;
    gap: 25px;
    margin-top: 25px;
}

.input-group {
    position: relative;
}

.input-group input,
.input-group textarea {
    width: 100%;
    padding: 14px 18px;
    background: transparent;
    color: #fff;
    border: 2px solid rgba(255, 255, 255, .25);
    border-radius: 14px;
    outline: none;
    transition: .3s;
}

.input-group textarea {
    min-height: 120px;
    resize: vertical;
}

.input-group input:focus,
.input-group textarea:focus {
    border-color: #fff;
    box-shadow: 0 0 8px #fff;
    background: rgba(255, 255, 255, .1);
}

.input-group label {
    position: absolute;
    top: 14px;
    left: 18px;
    color: rgba(255, 255, 255, .5);
    transition: .3s;
    font-size: 1rem;
    pointer-events: none;
}

.input-group input:focus+label,
.input-group input:not(:placeholder-shown)+label,
.input-group textarea:focus+label,
.input-group textarea:not(:placeholder-shown)+label {
    top: -12px;
    left: 14px;
    font-size: .8rem;
    background: #000;
    padding: 0 6px;
    border-radius: 6px;
    color: #fff;
}

.input-error {
    display: none;
    font-size: .75rem;
    color: #ff4d4d;
    margin-top: 5px;
}

.btn-submit {
    align-self: center;
    width: 170px;
    font-weight: 700;
}

.contato-links {
    display: flex;
    justify-content: center;
    gap: 35px;
    margin-top: 35px;
}

.icon-link {
    text-decoration: none;
    color: #fff;
    padding: 8px 18px;
    border-radius: 12px;
    transition: .3s;
    background: rgba(255, 255, 255, .05);
}

.icon-link:hover {
    background: rgba(255, 255, 255, .2);
}

.modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, .7);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 50;
}

.modal.show .modal-content {
    transform: scale(1);
    opacity: 1;
}

.modal-content {
    max-width: 450px;
    padding: 30px;
    transform: scale(.7);
    opacity: 0;
    transition: .3s;
}

.close {
    float: right;
    font-size: 28px;
    cursor: pointer;
}

@media(max-width:750px) {
    .menu-btn {
        display: block;
    }

    .nav-links {
        position: absolute;
        top: 80px;
        right: 20px;
        background: rgba(255, 255, 255, .08);
        border-radius: 18px;
        flex-direction: column;
        gap: 20px;
        padding: 25px;
        display: none;
    }

    .nav-links.open {
        display: flex;
    }
}

.carousel {
    position: relative;
    margin: 40px auto 0 auto;
    max-width: 900px;
    overflow: hidden;
    border-radius: 20px;
    padding: 20px;
    background: rgba(255,255,255,0.05);
    box-shadow: 0 0 20px rgba(255,255,255,0.1);
}

.carousel-track {
    display: flex;
    transition: transform 0.6s ease-in-out;
}

.carousel-item {
    min-width: 100%;
    transition: transform 0.6s ease-in-out;
    user-select: none;
}

.carousel-item img {
    width: 100%;
    border-radius: 15px;
    display: block;
}

.carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.2);
    border: none;
    padding: 10px 15px;
    font-size: 30px;
    cursor: pointer;
    border-radius: 50%;
    color: #fff;
    transition: background 0.3s;
    z-index: 10;
}

.carousel-btn:hover {
    background: rgba(255,255,255,0.4);
}

.carousel-btn.prev {
    left: 15px;
}

.carousel-btn.next {
    right: 15px;
}

.carousel-indicators {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
}

.carousel-indicators .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
    cursor: pointer;
    transition: background 0.3s;
}

.carousel-indicators .dot.active {
    background: #fff;
}
